{
  "name": "linnet",
  "private": true,
  "version": "0.0.0",
  "description": "Linnet - a Matrix client between Element and Cinny (desktop-first, Electron, AGPL-3.0-only).",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
